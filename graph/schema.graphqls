# GraphQL schema example
#
# https://gqlgen.com/getting-started/

directive @goField(forceResolver: Boolean, name: String, omittable: Boolean) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

scalar Int64
scalar Time

type Season {
	start: Time!
	end: Time!
	leagues: [League!]!
}

type NHLFranchise {
	id: Int!
	fullName: String!
	teamCommonName: String!
	teamPlaceName: String!
}

type LocalFile {
	path: String!
	type: String!
}

type Configuration {
	apiTLSEnabled: Boolean!
	apiPort: Int!
	dataPath: String!
	leagueID: Int!
	logLevel: String!
	metricsPort: Int!
	metricsRefreshInterval: Int!
	metricsTLSEnabled: Boolean!
	postgresDB: String!
	postgresHost: String!
	postgresPassword: String!
	postgresPort: Int!
	postgresSSLMode: String!
	postgresTimeZone: String!
	postgresUser: String!
	redisDB: String!
	redisPassword: String!
	redisURL: String!
	seasons: String!
	teamIDs: [Int!]!
	temporalHostPort: String!
	temporalNamespace: String!
	tlsCertificate: String!
	tlsKey: String!
	uiURL: String!
	workerPort: Int!
	workerTLSEnabled: Boolean!
	yahooOAuth2ClientID: String!
	yahooOAuth2ClientRedirect: String!
	yahooOAuth2ClientSecret: String!
}

type OAuth2Token {
	accessToken: String!
	tokenType: String!
	refreshToken: String!
	expiry: String!
}

type DBStats {
	nhlFranchises: Int! @goField(name: "NHLFranchises")
	nhlSeasons: Int! @goField(name: "NHLSeasons")
	nhlSeasonTeams: Int! @goField(name: "NHLSeasonTeams")
	fantasyGames: Int!
	leagues: Int!
	players: Int!
	playerStats: Int!
	games: Int!
	teams: Int!
	rosterPlayers: Int!
	standings: Int!
	teamSummaries: Int!
}

type LocalStats {
	fantasyGames: Int!
	leagues: Int!
	gamesLists: Int!
	games: Int!
	teams: Int!
	rosters: Int!
	teamsSummaries: Int!
	# Standings: Int!
}

#type Status {
#	Version: String!
#	Configuration: Configuration!
#	DBStats: DBStats!
#	LocalStats: LocalStats!
#	GameKey: Int!
#	SeasonStart: Time!
#	SeasonEnd: Time!
#	CurrentUser: String!
#	OAuth2Token: OAuth2Token
#}

type FantasyGame {
	id: Int!
	key: Int!
	name: String!
	code: String!
	type: String!
	url: String!
	season: Int!
	isRegistrationOver: Boolean!
	isGameOver: Boolean!
	isOffSeason: Boolean!
	localFile: LocalFile!
	createdAt: Time!
	updatedAt: Time!
}

type League {
	id: Int!
	key: String!
	name: String!
	url: String!
	logoURL: String!
	draftStatus: String!
	numTeams: Int!
	editKey: String!
	LeagueUpdateTimestamp: Int64!
	scoringType: String!
	leagueType: String!
	isProLeague: Boolean!
	isCashLeague: Boolean!
	startDate: Time!
	endDate: Time!
	gameCode: String!
	season: Int!
	localFile: LocalFile!
	createdAt: Time!
	updatedAt: Time!
}

type Manager  {
	ManagerID: Int!
	Nickname: String!
	GUID: String!
	EMail: String!
	ImageURL: String!
}

type Team {
	ID: Int!
	Key: String!
	Name: String!
	IsOwnedByCurrentLogin: Boolean!
	URL: String!
	DraftPosition: Int!
	HasDraftGrade: Boolean!
	Manager: Manager!
	#GithubTimestamp       time.Time
}

type Player {
	id: Int64!
	yahooID: Int64
	firstName: String!
	lastName: String!
	nhlTeamID: Int64 @goField(name: "NHLTeamID")
	position: String!
	shootsCatches: String!
	heightInches: Int
	weightPounds: Int
	birthDate: String
	birthCity: String
	birthStateProvince: String
	birthCountry: String
	sweaterNumber: Int
	isActive: Boolean!
	headshotURL: String!
	heroImageURL: String
	yahooImageSmall: String!
	yahooImageMedium: String!
	yahooImageLarge: String!
	yahooHomeURL: String!
	playerSlug: String
	draftYear: Int
	draftTeamAbbrev: String
	draftRound: Int
	draftPickInRound: Int
	draftOverallPick: Int
}

input PlayersFilter {
	name: String
	sweaterNumber: Int
	hasYahooID: Boolean
	teamID: Int
	position: String
	isActive: Boolean
}

enum TemporalWorkflowStatus {
	UNSPECIFIED,
	RUNNING,
	COMPLETED,
	FAILED,
	CANCELED,
	TERMINATED,
	CONTINUED_AS_NEW,
	TIMED_OUT
}

type WorkflowResult {
	status: TemporalWorkflowStatus!
	failureReason: String
}

type ProgressItem {
	id: Int!
	description: String
	completedDescription: String
	total: Int!
	completed: Int!
	started: Boolean!
	startedAt: String
	completedAt: String
}

# ProgressDisplayStyle determines how items are rendered in the CLI.
enum ProgressDisplayStyle {
	# PHASES: Sequential steps shown with ✓/▶/indent prefixes (default)
	PHASES
	# GROUPED_ITEMS: Concurrent items shown under a single header with progress bars
	GROUPED_ITEMS
}

type WorkflowProgress {
	total: Int!
	completed: Int!
	message: String
	header: String
	items: [ProgressItem!]
	displayStyle: ProgressDisplayStyle
}

# TrulyUnmatchedPlayer represents a Yahoo player who has NHL games but wasn't matched.
# These need investigation.
type TrulyUnmatchedPlayer {
	yahooID: Int!
	firstName: String!
	lastName: String!
	nhlGames: Int!
	nhlPlayerID: Int!
	nhlName: String!
}

type ImportPlayersResultData {
	totalPlayers: Int!
	importedPlayers: Int!
	matchedWithYahoo: Int!
	# Yahoo player stats
	totalYahooPlayers: Int!
	skippedNonNHL: Int! @goField(name: "SkippedNonNHL")            # Excluded at load (verified non-NHL from previous runs)
	verifiedNonNHLThisRun: Int! @goField(name: "VerifiedNonNHLThisRun")    # Verified as non-NHL during this run
	trulyUnmatched: [TrulyUnmatchedPlayer!]!  # Have NHL games but weren't matched
	errors: [String!]!
}

type InitializeResultData {
	franchisesUpserted: Int!
	seasonsUpserted: Int!
	seasonTeamsUpserted: Int!
}

type Query {
	buildNumber: Int!

	initializeResult: WorkflowResult!
	initializeProgress: WorkflowProgress
	initializeResultData: InitializeResultData

	downloadSeasonsResult: WorkflowResult!
	downloadSeasonsProgress: WorkflowProgress

	downloadYahooPlayersResult: WorkflowResult!
	downloadYahooPlayersProgress: WorkflowProgress

	downloadPlayersResult: WorkflowResult!
	downloadPlayersProgress: WorkflowProgress

	importPlayersResult: WorkflowResult!
	importPlayersProgress: WorkflowProgress
	importPlayersResultData: ImportPlayersResultData

	importSeasonsResult: WorkflowResult!
	importSeasonsProgress: WorkflowProgress
}


input DownloadSeasonsInput {
	startSeason: Int
	endSeason: Int
	seasonConcurrency: Int
}

type Mutation {
	# TODO should this really be available in a mutation?
    clearDatabase: Boolean! # drop, create, init
    dropDatabase: Boolean! # deletes all the tables
    createDatabase: Boolean! # creates all the tables
    flushRedisDB: Boolean! # flushes all keys in the configured redis db

	initialize: Boolean!
	cancelInitialize: Boolean!

	downloadSeasons(input: DownloadSeasonsInput): Boolean!
	cancelDownloadSeasons: Boolean!

	downloadYahooPlayers: Boolean!
	cancelDownloadYahooPlayers: Boolean!

	downloadPlayers(input: DownloadSeasonsInput): Boolean!
	cancelDownloadPlayers: Boolean!

	importPlayers(input: DownloadSeasonsInput): Boolean!
	cancelImportPlayers: Boolean!

	importSeasons(input: DownloadSeasonsInput): Boolean!
	cancelImportSeasons: Boolean!

	importLeague(season: Int!, leagueID: Int!): League!
	importTeam(season: Int!, leagueID: Int!, teamID: Int!): Team!

}
